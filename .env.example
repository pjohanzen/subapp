# Copy to .env.local and fill in. Never commit .env* files (except this example).

# Supabase (free project: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Needed by the cron job and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used in email links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Generate a long random string.
CRON_SECRET=

# Email: "log" (default, logs only) or "resend"
EMAIL_DRIVER=log
RESEND_API_KEY=
# Must be on a domain verified in Resend. WAITING ON EXTERNAL PARTY.
EMAIL_FROM=
